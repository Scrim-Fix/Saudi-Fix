# cmd.exe breaks on LF-only batch files (labels and goto stop working),
# so Windows scripts are always stored and checked out with CRLF.
# Batch files are stored byte-for-byte (-text) so the raw download from
# GitHub and the "Download ZIP" button also keep CRLF.
*.bat    -text
*.cmd    -text
*.ps1    text eol=crlf
*.txt    text eol=crlf
LICENSE  text eol=crlf

*.md     text eol=lf

*.zip    binary
*.png    binary
